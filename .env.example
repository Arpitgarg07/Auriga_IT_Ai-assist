# Server configuration placeholders. Copy to .env and fill in your own values.
# Never commit real credentials — .env is gitignored, this template is not.
PORT=4000
# Public origin of this API. Used to build the OAuth callback when
# GOOGLE_CALLBACK_URL is blank. Never exposed to the frontend.
API_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# MongoDB
#
# Without this the API still boots and reports "not configured"; the app keeps
# working entirely on the browser's local storage.
# ---------------------------------------------------------------------------
MONGODB_URI=

# ---------------------------------------------------------------------------
# Sessions
#
# SESSION_SECRET signs the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production: sign-in is refused there without it.
# ---------------------------------------------------------------------------
SESSION_SECRET=
# How long a signed-in session lasts, in seconds. Default 30 days.
SESSION_TTL_SECONDS=2592000
# Force the cookie's Secure flag. Automatic when NODE_ENV=production.
COOKIE_SECURE=

# ---------------------------------------------------------------------------
# Google sign-in (OAuth 2.0)
#
# Create credentials at https://console.cloud.google.com/apis/credentials and
# add the callback below as an authorised redirect URI:
#   http://localhost:4000/api/auth/google/callback
# Without these the API reports Google sign-in as unavailable — the app is still
# fully usable, and developer sign-in covers local development.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# ---------------------------------------------------------------------------
# Development sign-in
#
# Creates a real account in your local database without Google, so the protected
# routes, user isolation and the reminder job can be exercised end to end.
# Disabled automatically when NODE_ENV=production. Set DEV_LOGIN=off to disable
# it in development too.
# ---------------------------------------------------------------------------
DEV_LOGIN=on
DEVELOPMENT_USER_EMAIL=developer@daymark.local
DEVELOPMENT_USER_NAME=Local Developer

# ---------------------------------------------------------------------------
# Email reminders (SMTP)
#
# Any SMTP provider works. For Gmail, create an App Password at
# https://myaccount.google.com/apppasswords — a normal account password will
# NOT work, and Daymark never asks for or stores one. For local testing, run
# MailHog or Mailpit and point EMAIL_HOST/EMAIL_PORT at it.
#
# The app boots fine without these; email reminders simply report as
# "not configured" and nothing is ever pretended to have been sent.
# ---------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
# Set to "true" for implicit TLS on port 465. Automatic when EMAIL_PORT=465.
EMAIL_SECURE=
# SMTP username. For Gmail this is the full address.
EMAIL_USER=
# App Password or provider API key. NEVER commit a real value.
EMAIL_PASSWORD=
# The From header. Usually the same as EMAIL_USER.
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Reminder scheduling
# ---------------------------------------------------------------------------

# Morning-reminder timezone used by the scheduled job. Per-user timezones are
# not implemented; the job evaluates every user against this single zone.
REMINDER_TIMEZONE=Asia/Kolkata
# How often the scheduler checks whether any user's reminder time has arrived.
REMINDER_POLL_MINUTES=15
# Set to "off" to run the API without the scheduler.
REMINDER_SCHEDULER=on
# Protects POST /api/reminders/test and POST /api/reminders/run. Required in
# production; in development those endpoints are reachable without it.
REMINDER_ADMIN_TOKEN=

